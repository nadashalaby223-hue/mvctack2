@model List<mvctack2.Models.Instructor>

<h2>Instructor List</h2>

<table border="1" cellpadding="5">
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Salary</th>
        <th>Address</th>
        <th>Image</th>
        <th></th>
    </tr>
    @foreach (var item in Model)
    {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Salary</td>
                <td>@item.Address</td>
                <td><img src="~/images/@item.Imag" width="80" /></td>
                <td>
                    <a asp-controller="Instructor" asp-action="Details" asp-route-id="@item.Id">Details</a>
                </td>
            </tr>
    }
</table>